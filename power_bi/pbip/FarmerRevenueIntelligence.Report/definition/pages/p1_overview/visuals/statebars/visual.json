{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "statebars",
  "position": {
    "x": 16,
    "y": 488,
    "z": 14000,
    "width": 1000,
    "height": 224,
    "tabOrder": 14000
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_state"
                    }
                  },
                  "Property": "state_name"
                }
              },
              "queryRef": "dim_state.state_name",
              "nativeQueryRef": "state_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Gross Value @ MSP per ha (Rs)"
                }
              },
              "queryRef": "_Measures.Gross Value @ MSP per ha (Rs)",
              "nativeQueryRef": "Gross Value @ MSP per ha (Rs)"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "_Measures"
                  }
                },
                "Property": "Gross Value @ MSP per ha (Rs)"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Q3 Gross value per hectare by state (Rs/ha)'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    }
  },
  "filterConfig": {
    "filters": [
      {
        "name": "fArea",
        "field": {
          "Measure": {
            "Expression": {
              "SourceRef": {
                "Entity": "_Measures"
              }
            },
            "Property": "MSP-valued Area (ha)"
          }
        },
        "type": "Advanced",
        "filter": {
          "Version": 2,
          "From": [
            {
              "Name": "m",
              "Entity": "_Measures",
              "Type": 0
            }
          ],
          "Where": [
            {
              "Condition": {
                "Comparison": {
                  "ComparisonKind": 2,
                  "Left": {
                    "Measure": {
                      "Expression": {
                        "SourceRef": {
                          "Source": "m"
                        }
                      },
                      "Property": "MSP-valued Area (ha)"
                    }
                  },
                  "Right": {
                    "Literal": {
                      "Value": "500000D"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    ]
  }
}