	partition ref_sources = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportFolder & "ref_sources.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(Nulls, {{"source_id", type text}, {"dataset", type text}, {"publisher", type text}, {"coverage", type text}, {"grain", type text}, {"used_for", type text}, {"access_route", type text}, {"url", type text}, {"reliability_note", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
