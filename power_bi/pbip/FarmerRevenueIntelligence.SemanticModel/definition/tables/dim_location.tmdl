	partition dim_location = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportFolder & "dim_location.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(Nulls, {{"location_id", Int64.Type}, {"state_name", type text}, {"district_name", type text}, {"state_id", Int64.Type}, {"district_key", type text}, {"first_year", Int64.Type}, {"last_year", Int64.Type}}, "en-US")
				in
				    Typed

