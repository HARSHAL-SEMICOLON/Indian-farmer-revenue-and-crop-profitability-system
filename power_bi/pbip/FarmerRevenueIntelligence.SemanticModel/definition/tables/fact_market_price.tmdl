	partition fact_market_price = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportFolder & "fact_market_price.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(Nulls, {{"price_id", Int64.Type}, {"market_id", Int64.Type}, {"crop_id", Int64.Type}, {"date_key", Int64.Type}, {"source_dataset", type text}, {"granularity", type text}, {"commodity_raw", type text}, {"variety", type text}, {"price_form", type text}, {"msp_comparable", Int64.Type}, {"arrivals_qtl", type number}, {"min_price", type number}, {"max_price", type number}, {"modal_price", type number}, {"price_spread", type number}, {"price_spread_pct", type number}, {"msp_crop_year", type number}, {"msp_applicable", type number}, {"modal_vs_msp_pct", type number}, {"modal_below_msp", type number}, {"msp_price_band", type text}, {"msp_price_band_order", type number}, {"dq_flag", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
