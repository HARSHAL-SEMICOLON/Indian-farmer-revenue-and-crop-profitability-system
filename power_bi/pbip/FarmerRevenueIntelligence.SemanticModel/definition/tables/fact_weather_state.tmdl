	partition fact_weather_state = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportFolder & "fact_weather_state.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(Nulls, {{"state_weather_id", Int64.Type}, {"crop_year", Int64.Type}, {"jjas_mm", type number}, {"rabi_rain_mm", type number}, {"annual_mm", type number}, {"jjas_normal_mm", type number}, {"rabi_rain_normal_mm", type number}, {"annual_normal_mm", type number}, {"state_name", type text}, {"n_subdivisions", Int64.Type}, {"jjas_dep_pct", type number}, {"rabi_rain_dep_pct", type number}, {"annual_dep_pct", type number}, {"jjas_category", type text}, {"rainfall_basis", type text}, {"state_id", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
