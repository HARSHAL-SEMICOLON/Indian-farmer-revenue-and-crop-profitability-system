	partition dim_market = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportFolder & "dim_market.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(Nulls, {{"market_id", Int64.Type}, {"market_name", type text}, {"district_name", type text}, {"state_name", type text}, {"first_seen_in", type text}, {"state_id", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
