	partition dim_state = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportFolder & "dim_state.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(Nulls, {{"state_id", Int64.Type}, {"state_name", type text}, {"region", type text}, {"state_group", type text}, {"imd_subdivisions", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
