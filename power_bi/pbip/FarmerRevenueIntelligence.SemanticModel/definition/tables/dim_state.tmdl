table dim_state
	lineageTag: 2cfb9258-9d66-4edb-8aab-43b75085bb6d

	column state_id
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 6bc46c2f-ddbf-4803-84cd-09246bd50c08
		summarizeBy: none
		sourceColumn: state_id

