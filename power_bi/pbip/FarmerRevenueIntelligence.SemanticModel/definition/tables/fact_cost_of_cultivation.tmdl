	partition fact_cost_of_cultivation = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportFolder & "fact_cost_of_cultivation.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(Nulls, {{"cost_id", Int64.Type}, {"crop_name", type text}, {"state_name", type text}, {"crop_year", Int64.Type}, {"a2fl_per_ha", type number}, {"c2_per_ha", type number}, {"c2_per_qtl", type number}, {"implied_yield_qtl_per_ha", type number}, {"crop_year_label", type text}, {"crop_id", Int64.Type}, {"state_id", Int64.Type}, {"source", type text}}, "en-US")
