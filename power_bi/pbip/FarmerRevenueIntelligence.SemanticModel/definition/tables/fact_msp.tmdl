	partition fact_msp = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportFolder & "fact_msp.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(Nulls, {{"msp_id", Int64.Type}, {"crop_id", Int64.Type}, {"msp_key", type text}, {"crop_year", Int64.Type}, {"crop_year_label", type text}, {"marketing_season", type text}, {"season", type text}, {"variety", type text}, {"msp_base", type number}, {"bonus", type number}, {"bonus_verified", Int64.Type}, {"msp_effective", type number}, {"a2fl_cost", type number}, {"msp_over_a2fl_pct", type number}, {"msp_real_2018", type number}, {"source_id", type text}, {"source_title", type text}, {"source_url", type text}, {"verification", type text}, {"note", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
